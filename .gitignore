# --- Python ---
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.ipynb_checkpoints/

# --- Environments / secrets ---
.env
.venv/
venv/

# --- Editors & tooling ---
.idea/
.vscode/
.DS_Store
